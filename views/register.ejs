<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📝 إنشاء حساب - منصة التكافل السوداني</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --sudan-red: #C8102E;
            --sudan-green: #007229;
        }
        
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Tahoma', 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .register-container {
            background: white;
            border-radius: 25px;
            box-shadow: 0 15px 50px rgba(0,0,0,0.15);
            max-width: 500px;
            width: 100%;
            padding: 40px;
            position: relative;
            overflow: hidden;
        }
        
        .register-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, 
                var(--sudan-red) 0%, 
                var(--sudan-red) 33%,
                #fff 33%,
                #fff 66%,
                #000 66%,
                #000 100%
            );
        }
        
        .register-header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .register-header .logo-icon {
            font-size: 50px;
            color: var(--sudan-green);
            background: #f8f9fa;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
            border: 3px solid var(--sudan-red);
        }
        
        .register-header h3 {
            color: var(--sudan-green);
            font-weight: bold;
        }
        
        .register-header p {
            color: #666;
            font-size: 0.9rem;
        }
        
        .flag-stripes {
            height: 3px;
            background: linear-gradient(90deg, 
                var(--sudan-red) 0%, 
                var(--sudan-red) 33%,
                #fff 33%,
                #fff 66%,
                #000 66%,
                #000 100%
            );
            margin: 10px 0;
            border-radius: 2px;
        }
        
        .form-control {
            border-radius: 12px;
            padding: 12px 18px;
            border: 2px solid #e9ecef;
            transition: all 0.3s ease;
        }
        
        .form-control:focus {
            border-color: var(--sudan-green);
            box-shadow: 0 0 0 0.2rem rgba(0, 114, 41, 0.2);
        }
        
        .btn-register {
            background: linear-gradient(135deg, var(--sudan-green), #00531e);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: bold;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            width: 100%;
        }
        
        .btn-register:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 20px rgba(0, 114, 41, 0.4);
            color: white;
        }
        
        .input-group-text {
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-left: none;
            border-radius: 12px 0 0 12px;
            color: var(--sudan-green);
        }
        
        .input-group .form-control {
            border-radius: 0 12px 12px 0;
        }
        
        .form-label {
            font-weight: 600;
            color: #333;
        }
        
        .login-link {
            text-align: center;
            margin-top: 20px;
            color: #666;
        }
        
        .login-link a {
            color: var(--sudan-red);
            font-weight: bold;
            text-decoration: none;
        }
        
        .login-link a:hover {
            text-decoration: underline;
        }
        
        .back-link {
            display: inline-block;
            margin-top: 15px;
            color: #6c757d;
            text-decoration: none;
            font-size: 0.9rem;
        }
        
        .back-link:hover {
            color: var(--sudan-red);
        }
        
        .alert {
            border-radius: 12px;
            border: none;
        }
        
        .password-hint {
            font-size: 0.8rem;
            color: #888;
            margin-top: 4px;
        }
        
        .gift-info {
            background: linear-gradient(135deg, #fff3cd, #ffeaa7);
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            border-right: 4px solid #ffc107;
        }
        
        .gift-info h6 {
            color: #856404;
            font-weight: bold;
        }
        
        .gift-info ul {
            padding-right: 20px;
            margin-bottom: 0;
            font-size: 0.9rem;
            color: #555;
        }
        
        .gift-info .gift-amount {
            font-size: 1.5rem;
            font-weight: bold;
            color: #28a745;
        }
        
        .strength-meter {
            height: 4px;
            background: #e9ecef;
            border-radius: 2px;
            margin-top: 8px;
            overflow: hidden;
        }
        
        .strength-meter .strength-bar {
            height: 100%;
            width: 0%;
            transition: width 0.3s ease;
        }
    </style>
</head>
<body>

<div class="register-container">
    <!-- Flag Stripes -->
    <div class="flag-stripes"></div>
    
    <!-- الهيدر -->
    <div class="register-header">
        <div class="logo-icon">
            <i class="fas fa-user-plus"></i>
        </div>
        <h3>📝 إنشاء حساب جديد</h3>
        <p>انضم إلى منصة التكافل السوداني 🇸🇩</p>
    </div>

    <!-- رسائل الخطأ -->
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <!-- ============================================================ -->
    <!-- معلومات الرصيد الترحيبي -->
    <!-- ============================================================ -->
    <div class="gift-info">
        <h6><i class="fas fa-gift"></i> 🎁 هدية الترحيب</h6>
        <p class="mb-1">
            عند إنشاء حسابك، ستحصل على 
            <span class="gift-amount">💰 5000 نقطة ترحيبية</span>
        </p>
        <ul>
            <li>✅ رصيد وهمي يعكس نشاطك في المنصة</li>
            <li>✅ يظهر في ملفك الشخصي</li>
            <li>✅ يزيد من مكانتك في المجتمع</li>
            <li>✅ يشجعك على المشاركة أكثر</li>
        </ul>
        <small class="text-muted">
            <i class="fas fa-info-circle"></i> 
            هذا الرصيد ترويجي وليس له قيمة مالية حقيقية
        </small>
    </div>

    <!-- نموذج إنشاء حساب -->
    <form action="/register" method="POST">
        <div class="mb-3">
            <label class="form-label">
                <i class="fas fa-user"></i> اسم المستخدم *
            </label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fas fa-user"></i>
                </span>
                <input type="text" name="username" class="form-control" 
                       placeholder="أدخل اسم مستخدم فريد" required autofocus>
            </div>
            <small class="text-muted">سيظهر في رابط ملفك الشخصي</small>
        </div>
        
        <div class="mb-3">
            <label class="form-label">
                <i class="fas fa-id-card"></i> الاسم الكامل *
            </label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fas fa-user"></i>
                </span>
                <input type="text" name="full_name" class="form-control" 
                       placeholder="أدخل اسمك الكامل" required>
            </div>
        </div>
        
        <div class="mb-3">
            <label class="form-label">
                <i class="fas fa-map-marker-alt"></i> الولاية *
            </label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fas fa-map-marker-alt"></i>
                </span>
                <select name="state" class="form-control" required>
                    <option value="">اختر ولايتك</option>
                    <option value="الخرطوم">الخرطوم</option>
                    <option value="أم درمان">أم درمان</option>
                    <option value="الخرطوم بحري">الخرطوم بحري</option>
                    <option value="جزيرة">جزيرة</option>
                    <option value="كردفان">كردفان</option>
                    <option value="دارفور">دارفور</option>
                    <option value="النيل الأزرق">النيل الأزرق</option>
                    <option value="نهر النيل">نهر النيل</option>
                    <option value="البحر الأحمر">البحر الأحمر</option>
                    <option value="أخرى">أخرى</option>
                </select>
            </div>
        </div>
        
        <div class="mb-3">
            <label class="form-label">
                <i class="fas fa-phone"></i> رقم الهاتف (اختياري)
            </label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fas fa-phone"></i>
                </span>
                <input type="tel" name="phone" class="form-control" 
                       placeholder="مثال: 0912345678">
            </div>
        </div>
        
        <div class="mb-3">
            <label class="form-label">
                <i class="fas fa-lock"></i> كلمة المرور *
            </label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fas fa-lock"></i>
                </span>
                <input type="password" name="password" class="form-control" 
                       placeholder="أدخل كلمة مرور (6 أحرف على الأقل)" required minlength="6">
            </div>
            <div class="strength-meter">
                <div class="strength-bar" id="strengthBar"></div>
            </div>
            <div class="password-hint">
                <i class="fas fa-info-circle"></i> يجب أن تكون كلمة المرور 6 أحرف على الأقل
            </div>
        </div>
        
        <div class="mb-3">
            <label class="form-label">
                <i class="fas fa-check-circle"></i> تأكيد كلمة المرور *
            </label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fas fa-check-circle"></i>
                </span>
                <input type="password" name="confirm_password" class="form-control" 
                       placeholder="أعد كتابة كلمة المرور" required>
            </div>
        </div>
        
        <button type="submit" class="btn-register">
            <i class="fas fa-user-plus"></i> إنشاء الحساب
        </button>
    </form>

    <!-- رابط تسجيل الدخول -->
    <div class="login-link">
        لديك حساب بالفعل؟ <a href="/login">تسجيل الدخول</a>
    </div>

    <!-- رابط العودة للرئيسية -->
    <div class="text-center">
        <a href="/" class="back-link">
            <i class="fas fa-arrow-right"></i> العودة للرئيسية
        </a>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
// قياس قوة كلمة المرور
document.querySelector('input[name="password"]').addEventListener('input', function() {
    const password = this.value;
    const bar = document.getElementById('strengthBar');
    let strength = 0;
    
    if (password.length >= 6) strength += 20;
    if (password.length >= 10) strength += 20;
    if (/[a-z]/.test(password)) strength += 20;
    if (/[A-Z]/.test(password)) strength += 20;
    if (/[0-9]/.test(password)) strength += 20;
    
    bar.style.width = strength + '%';
    
    if (strength < 40) {
        bar.style.background = '#dc3545';
    } else if (strength < 70) {
        bar.style.background = '#ffc107';
    } else {
        bar.style.background = '#28a745';
    }
});
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔐 تسجيل الدخول - منصة التكافل السوداني</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --sudan-red: #C8102E;
            --sudan-green: #007229;
        }
        
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Tahoma', 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .login-container {
            background: white;
            border-radius: 25px;
            box-shadow: 0 15px 50px rgba(0,0,0,0.15);
            max-width: 450px;
            width: 100%;
            padding: 40px;
            position: relative;
            overflow: hidden;
        }
        
        .login-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, 
                var(--sudan-red) 0%, 
                var(--sudan-red) 33%,
                #fff 33%,
                #fff 66%,
                #000 66%,
                #000 100%
            );
        }
        
        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .login-header .logo-icon {
            font-size: 50px;
            color: var(--sudan-red);
            background: #f8f9fa;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
            border: 3px solid var(--sudan-green);
        }
        
        .login-header h3 {
            color: var(--sudan-red);
            font-weight: bold;
        }
        
        .login-header p {
            color: #666;
            font-size: 0.9rem;
        }
        
        .flag-stripes {
            height: 3px;
            background: linear-gradient(90deg, 
                var(--sudan-red) 0%, 
                var(--sudan-red) 33%,
                #fff 33%,
                #fff 66%,
                #000 66%,
                #000 100%
            );
            margin: 10px 0;
            border-radius: 2px;
        }
        
        .form-control {
            border-radius: 12px;
            padding: 12px 18px;
            border: 2px solid #e9ecef;
            transition: all 0.3s ease;
        }
        
        .form-control:focus {
            border-color: var(--sudan-green);
            box-shadow: 0 0 0 0.2rem rgba(0, 114, 41, 0.2);
        }
        
        .btn-login {
            background: linear-gradient(135deg, var(--sudan-red), #8B0000);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: bold;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            width: 100%;
        }
        
        .btn-login:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 20px rgba(200, 16, 46, 0.4);
            color: white;
        }
        
        .btn-login i {
            margin-left: 8px;
        }
        
        .btn-register {
            background: linear-gradient(135deg, var(--sudan-green), #00531e);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: bold;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            width: 100%;
        }
        
        .btn-register:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 20px rgba(0, 114, 41, 0.4);
            color: white;
        }
        
        .input-group-text {
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-left: none;
            border-radius: 12px 0 0 12px;
            color: var(--sudan-green);
        }
        
        .input-group .form-control {
            border-radius: 0 12px 12px 0;
        }
        
        .form-label {
            font-weight: 600;
            color: #333;
        }
        
        .register-link {
            text-align: center;
            margin-top: 20px;
            color: #666;
        }
        
        .register-link a {
            color: var(--sudan-green);
            font-weight: bold;
            text-decoration: none;
        }
        
        .register-link a:hover {
            text-decoration: underline;
        }
        
        .back-link {
            display: inline-block;
            margin-top: 15px;
            color: #6c757d;
            text-decoration: none;
            font-size: 0.9rem;
        }
        
        .back-link:hover {
            color: var(--sudan-red);
        }
        
        .alert {
            border-radius: 12px;
            border: none;
        }
        
        .instructions-box {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 15px;
            margin-top: 20px;
            border-right: 4px solid var(--sudan-green);
        }
        
        .instructions-box h6 {
            color: var(--sudan-green);
            font-weight: bold;
        }
        
        .instructions-box ul {
            padding-right: 20px;
            margin-bottom: 0;
            font-size: 0.85rem;
            color: #555;
        }
        
        .instructions-box ul li {
            margin-bottom: 4px;
        }
    </style>
</head>
<body>

<div class="login-container">
    <!-- Flag Stripes -->
    <div class="flag-stripes"></div>
    
    <!-- الهيدر -->
    <div class="login-header">
        <div class="logo-icon">
            <i class="fas fa-hand-holding-heart"></i>
        </div>
        <h3>🔐 تسجيل الدخول</h3>
        <p>منصة التكافل السوداني 🇸🇩</p>
    </div>

    <!-- رسائل الخطأ -->
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <!-- نموذج تسجيل الدخول -->
    <form action="/login" method="POST">
        <div class="mb-3">
            <label class="form-label">
                <i class="fas fa-user"></i> اسم المستخدم
            </label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fas fa-user"></i>
                </span>
                <input type="text" name="username" class="form-control" 
                       placeholder="أدخل اسم المستخدم" required autofocus>
            </div>
        </div>
        
        <div class="mb-3">
            <label class="form-label">
                <i class="fas fa-lock"></i> كلمة المرور
            </label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fas fa-lock"></i>
                </span>
                <input type="password" name="password" class="form-control" 
                       placeholder="أدخل كلمة المرور" required>
            </div>
        </div>
        
        <button type="submit" class="btn-login">
            <i class="fas fa-sign-in-alt"></i> تسجيل الدخول
        </button>
    </form>

    <!-- رابط التسجيل -->
    <div class="register-link">
        ليس لديك حساب؟ <a href="/register">إنشاء حساب جديد</a>
    </div>

    <!-- رابط العودة للرئيسية -->
    <div class="text-center">
        <a href="/" class="back-link">
            <i class="fas fa-arrow-right"></i> العودة للرئيسية
        </a>
    </div>

    <!-- تعليمات الاستخدام -->
    <div class="instructions-box">
        <h6><i class="fas fa-info-circle"></i> تعليمات تسجيل الدخول:</h6>
        <ul>
            <li>🔹 أدخل <strong>اسم المستخدم</strong> الذي سجلت به</li>
            <li>🔹 أدخل <strong>كلمة المرور</strong> الخاصة بك</li>
            <li>🔹 إذا نسيت كلمة المرور، تواصل مع المشرف</li>
            <li>🔹 تأكد من كتابة البيانات بشكل صحيح</li>
        </ul>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

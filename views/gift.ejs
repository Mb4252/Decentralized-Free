<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎁 هديتي - منصة التكافل السوداني</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #fff3cd, #ffeaa7);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Tahoma', 'Segoe UI', sans-serif;
            padding: 20px;
        }
        .gift-card {
            background: white;
            border-radius: 25px;
            padding: 40px;
            max-width: 500px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .gift-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,193,7,0.1) 0%, transparent 70%);
            animation: shimmer 4s ease-in-out infinite;
        }
        @keyframes shimmer {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(20%, 20%); }
        }
        .gift-icon {
            font-size: 80px;
            color: #ffc107;
            position: relative;
            z-index: 1;
            animation: bounce 2s ease-in-out infinite;
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        .gift-amount {
            font-size: 3rem;
            font-weight: bold;
            color: #28a745;
            position: relative;
            z-index: 1;
        }
        .gift-card h3 {
            position: relative;
            z-index: 1;
            color: #333;
        }
        .gift-card p {
            position: relative;
            z-index: 1;
            color: #666;
        }
        .btn-gift {
            background: linear-gradient(135deg, #ffc107, #e0a800);
            color: #333;
            border: none;
            padding: 12px 40px;
            border-radius: 30px;
            font-weight: bold;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
        }
        .btn-gift:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 20px rgba(255, 193, 7, 0.4);
        }
        .flag-stripes {
            height: 4px;
            background: linear-gradient(90deg, #C8102E 33%, #fff 33%, #fff 66%, #000 66%);
            margin: 15px 0;
            border-radius: 2px;
            position: relative;
            z-index: 1;
        }
        .gift-status {
            font-size: 1.1rem;
            padding: 10px;
            border-radius: 10px;
            position: relative;
            z-index: 1;
        }
    </style>
</head>
<body>
    <div class="gift-card">
        <div class="flag-stripes"></div>
        <div class="gift-icon">
            <i class="fas fa-gift"></i>
        </div>
        <h3>🎁 هدية الترحيب</h3>
        <p>شكراً لانضمامك إلى منصة التكافل السوداني</p>
        
        <% if (currentUser && currentUser.gift_received) { %>
            <div class="gift-amount">
                💰 <%= currentUser.gift_balance || 0 %> ج
            </div>
            <div class="gift-status text-success">
                <i class="fas fa-check-circle"></i> تم استلام الهدية
            </div>
            <p class="text-muted">تم منحك هذه الهدية كترحيب من المنصة</p>
            <small class="text-muted">
                تم الاستلام في: <%= currentUser.gift_date ? new Date(currentUser.gift_date).toLocaleString('ar-EG') : 'اليوم' %>
            </small>
        <% } else { %>
            <div class="gift-status text-warning">
                <i class="fas fa-clock"></i> في انتظار الهدية
            </div>
            <p class="text-muted">سيتم منحك 5000 ج عند تفعيل حسابك</p>
        <% } %>
        
        <div class="mt-3">
            <a href="/" class="btn btn-gift">
                <i class="fas fa-home"></i> العودة للرئيسية
            </a>
        </div>
        <div class="flag-stripes mt-3"></div>
    </div>
</body>
</html>

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>👤 الملف الشخصي - منصة التكافل السوداني</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --sudan-red: #C8102E;
            --sudan-green: #007229;
        }
        
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Tahoma', 'Segoe UI', sans-serif;
            min-height: 100vh;
            padding: 20px;
        }
        
        .profile-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            max-width: 800px;
            margin: auto;
            padding: 30px;
            position: relative;
            overflow: hidden;
        }
        
        .profile-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 8px;
            background: linear-gradient(90deg, 
                var(--sudan-red) 0%, 
                var(--sudan-red) 33%,
                #fff 33%,
                #fff 66%,
                #000 66%,
                #000 100%
            );
        }
        
        .avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--sudan-red), #8B0000);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            border: 4px solid var(--sudan-green);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        
        .avatar i {
            font-size: 60px;
            color: white;
        }
        
        .username {
            font-size: 28px;
            font-weight: bold;
            color: var(--sudan-red);
            text-align: center;
        }
        
        .full-name {
            text-align: center;
            font-size: 20px;
            color: #333;
        }
        
        .stat-box {
            background: #f8f9fa;
            border-radius: 15px;
            padding: 15px;
            text-align: center;
            border-right: 4px solid var(--sudan-green);
            transition: all 0.3s ease;
        }
        
        .stat-box:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        .stat-number {
            font-size: 28px;
            font-weight: bold;
            color: var(--sudan-red);
        }
        
        .stat-label {
            color: #666;
            font-size: 14px;
        }
        
        .info-item {
            padding: 12px 0;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .info-item:last-child {
            border-bottom: none;
        }
        
        .info-label {
            color: #666;
            font-weight: 500;
        }
        
        .info-value {
            font-weight: bold;
            color: #333;
        }
        
        .badge-state {
            background: var(--sudan-green);
            color: white;
            padding: 5px 20px;
            border-radius: 20px;
            font-size: 14px;
        }
        
        .btn-edit {
            background: linear-gradient(135deg, var(--sudan-green), #00531e);
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-weight: bold;
            transition: all 0.3s ease;
            width: 100%;
        }
        
        .btn-edit:hover {
            transform: scale(1.05);
            color: white;
            box-shadow: 0 4px 15px rgba(0, 114, 41, 0.4);
        }
        
        .btn-back {
            background: #6c757d;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 20px;
            transition: all 0.3s ease;
        }
        
        .btn-back:hover {
            background: #5a6268;
            color: white;
        }
        
        .recent-item {
            background: #f8f9fa;
            padding: 10px 15px;
            border-radius: 10px;
            margin-bottom: 8px;
            border-right: 3px solid var(--sudan-red);
            transition: all 0.3s ease;
        }
        
        .recent-item:hover {
            background: #e9ecef;
        }
        
        .modal-header-sudan {
            background: linear-gradient(135deg, var(--sudan-green), #00531e);
            color: white;
            border-radius: 15px 15px 0 0;
        }
        
        .modal-header-sudan .btn-close {
            filter: brightness(0) invert(1);
        }
        
        .flag-stripes {
            height: 4px;
            background: linear-gradient(90deg, 
                var(--sudan-red) 0%, 
                var(--sudan-red) 33%,
                #fff 33%,
                #fff 66%,
                #000 66%,
                #000 100%
            );
            margin: 10px 0;
            border-radius: 2px;
        }
        
        .btn-save {
            background: var(--sudan-green);
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-weight: bold;
        }
        
        .btn-save:hover {
            background: #00531e;
            color: white;
        }
        
        .btn-logout {
            background: #dc3545;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 20px;
            transition: all 0.3s ease;
        }
        
        .btn-logout:hover {
            transform: scale(1.05);
            color: white;
        }
        
        .user-badge {
            background: var(--sudan-green);
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

<div class="profile-card">
    <!-- Flag Stripes -->
    <div class="flag-stripes"></div>

    <!-- رسائل النجاح -->
    <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <!-- رسائل الخطأ -->
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <!-- شريط العلوي -->
    <div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <a href="/" class="btn btn-back">
            <i class="fas fa-arrow-right"></i> العودة للرئيسية
        </a>
        
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <% if (currentUser && currentUser.username === user.username) { %>
                <span class="user-badge">
                    <i class="fas fa-user-check"></i> أنت
                </span>
                <a href="/logout" class="btn btn-logout btn-sm">
                    <i class="fas fa-sign-out-alt"></i> خروج
                </a>
            <% } else { %>
                <span class="badge bg-secondary">
                    <i class="fas fa-eye"></i> زيارة
                </span>
            <% } %>
        </div>
    </div>

    <!-- الصورة الرمزية -->
    <div class="avatar">
        <i class="fas fa-user"></i>
    </div>

    <!-- اسم المستخدم -->
    <h1 class="username">@<%= user.username %></h1>
    <p class="full-name"><%= user.full_name %></p>

    <!-- الولاية -->
    <div class="text-center mb-4">
        <span class="badge-state">
            <i class="fas fa-map-marker-alt"></i> <%= user.state %>
        </span>
    </div>

    <!-- الإحصائيات -->
    <div class="row mb-4">
        <div class="col-6">
            <div class="stat-box">
                <div class="stat-number"><%= totalAdds %></div>
                <div class="stat-label">
                    <i class="fas fa-shopping-basket"></i> إضافات
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="stat-box">
                <div class="stat-number">
                    <%= user.created_at ? new Date(user.created_at).toLocaleDateString('ar-EG') : 'جديد' %>
                </div>
                <div class="stat-label">
                    <i class="fas fa-calendar"></i> تاريخ التسجيل
                </div>
            </div>
        </div>
    </div>

    <!-- معلومات المستخدم -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">
                <i class="fas fa-info-circle text-success"></i> معلومات الملف
            </h5>
            
            <div class="info-item">
                <span class="info-label">
                    <i class="fas fa-user"></i> اسم المستخدم
                </span>
                <span class="info-value">@<%= user.username %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">
                    <i class="fas fa-id-card"></i> الاسم الكامل
                </span>
                <span class="info-value"><%= user.full_name %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">
                    <i class="fas fa-map-marker-alt"></i> الولاية
                </span>
                <span class="info-value"><%= user.state %></span>
            </div>
            
            <% if (user.phone) { %>
            <div class="info-item">
                <span class="info-label">
                    <i class="fas fa-phone"></i> رقم الهاتف
                </span>
                <span class="info-value"><%= user.phone %></span>
            </div>
            <% } %>
            
            <div class="info-item">
                <span class="info-label">
                    <i class="fas fa-clock"></i> آخر نشاط
                </span>
                <span class="info-value">
                    <%= user.last_active ? new Date(user.last_active).toLocaleString('ar-EG') : 'غير متوفر' %>
                </span>
            </div>
        </div>
    </div>

    <!-- آخر الإضافات -->
    <% if (recentPrices.length > 0) { %>
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">
                <i class="fas fa-clock text-primary"></i> آخر إضافاتي
            </h5>
            <% recentPrices.forEach(p => { %>
            <div class="recent-item">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong><%= p.item %></strong>
                        <span class="text-muted"> - <%= p.location %></span>
                    </div>
                    <span class="text-danger fw-bold"><%= p.price %> ج.س</span>
                </div>
                <small class="text-muted">
                    <%= p.created_at ? new Date(p.created_at).toLocaleString('ar-EG') : '' %>
                </small>
            </div>
            <% }) %>
        </div>
    </div>
    <% } else { %>
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> لم تقم بإضافة أي أسعار حتى الآن
    </div>
    <% } %>

    <!-- زر تعديل الملف (فقط لصاحب الملف) -->
    <% if (currentUser && currentUser.username === user.username) { %>
    <button class="btn-edit" data-bs-toggle="modal" data-bs-target="#editProfileModal">
        <i class="fas fa-edit"></i> تعديل الملف الشخصي
    </button>
    <% } %>
</div>

<!-- ======================================== -->
<!-- مودال تعديل الملف الشخصي -->
<!-- ======================================== -->
<% if (currentUser && currentUser.username === user.username) { %>
<div class="modal fade" id="editProfileModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header modal-header-sudan">
                <h5 class="modal-title">
                    <i class="fas fa-user-edit"></i> تعديل الملف الشخصي
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/update_profile" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">الاسم الكامل *</label>
                        <input type="text" name="full_name" class="form-control" 
                               value="<%= user.full_name %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">الولاية *</label>
                        <select name="state" class="form-select" required>
                            <option value="الخرطوم" <%= user.state === 'الخرطوم' ? 'selected' : '' %>>الخرطوم</option>
                            <option value="أم درمان" <%= user.state === 'أم درمان' ? 'selected' : '' %>>أم درمان</option>
                            <option value="الخرطوم بحري" <%= user.state === 'الخرطوم بحري' ? 'selected' : '' %>>الخرطوم بحري</option>
                            <option value="جزيرة" <%= user.state === 'جزيرة' ? 'selected' : '' %>>جزيرة</option>
                            <option value="كردفان" <%= user.state === 'كردفان' ? 'selected' : '' %>>كردفان</option>
                            <option value="دارفور" <%= user.state === 'دارفور' ? 'selected' : '' %>>دارفور</option>
                            <option value="النيل الأزرق" <%= user.state === 'النيل الأزرق' ? 'selected' : '' %>>النيل الأزرق</option>
                            <option value="نهر النيل" <%= user.state === 'نهر النيل' ? 'selected' : '' %>>نهر النيل</option>
                            <option value="البحر الأحمر" <%= user.state === 'البحر الأحمر' ? 'selected' : '' %>>البحر الأحمر</option>
                            <option value="أخرى" <%= user.state === 'أخرى' ? 'selected' : '' %>>أخرى</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">رقم الهاتف (اختياري)</label>
                        <input type="tel" name="phone" class="form-control" 
                               value="<%= user.phone || '' %>" 
                               placeholder="مثال: 0912345678">
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> 
                        <strong>ملاحظة:</strong> اسم المستخدم لا يمكن تغييره
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-save">
                        <i class="fas fa-save"></i> حفظ التغييرات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<% } %>

<!-- ======================================== -->
<!-- JavaScript -->
<!-- ======================================== -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

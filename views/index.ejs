<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <title>منصة التكافل السوداني</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h2 class="text-center">سوق التكافل السوداني</h2>
    
    <div class="mb-3">
        <input type="text" id="searchInput" class="form-control" placeholder="بحث عن سلعة أو منطقة...">
    </div>

    <table class="table table-hover" id="priceTable">
        <thead class="table-dark">
            <tr><th>السلعة</th><th>السعر</th><th>المنطقة</th><th>التاريخ</th></tr>
        </thead>
        <tbody>
            <% prices.forEach(p => { %>
            <tr>
                <td><%= p.item %></td>
                <td><%= p.price %></td>
                <td><%= p.location %></td>
                <td><small class="text-muted"><%= new Date(p.created_at).toLocaleDateString('ar-EG') %></small></td>
            </tr>
            <% }) %>
        </tbody>
    </table>

    <footer class="mt-5 p-3 text-center border-top">
        <p class="text-muted small">هذه منصة تطوعية. الأسعار استرشادية وتعتمد على مساهمات المستخدمين.</p>
    </footer>

    <script>
        document.getElementById('searchInput').addEventListener('keyup', function() {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#priceTable tbody tr');
            rows.forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
</body>
</html>

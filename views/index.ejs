<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>منصة التكافل السوداني</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h2 class="text-center mb-4">سوق التكافل السوداني</h2>
    
    <!-- قسم إضافة سعر جديد -->
    <div class="card p-4 mb-4 shadow-sm">
        <h4>أضف سعر سلعة</h4>
        <form action="/add_price" method="POST" class="row g-3">
            <div class="col-md-4">
                <input name="item" class="form-control" placeholder="اسم السلعة (مثال: دقيق)" required>
            </div>
            <div class="col-md-3">
                <input name="price" class="form-control" placeholder="السعر" required>
            </div>
            <div class="col-md-3">
                <input name="location" class="form-control" placeholder="المنطقة/الحي" required>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">إضافة</button>
            </div>
        </form>
    </div>

    <!-- قسم البحث والفلترة -->
    <div class="mb-3">
        <input type="text" id="searchInput" class="form-control" placeholder="🔍 ابحث عن سلعة أو منطقة هنا...">
    </div>

    <!-- جدول الأسعار -->
    <table class="table table-hover border" id="priceTable">
        <thead class="table-dark">
            <tr>
                <th>السلعة</th>
                <th>السعر</th>
                <th>المنطقة</th>
                <th>التاريخ</th>
            </tr>
        </thead>
        <tbody>
            <% prices.forEach(p => { %>
            <tr>
                <td><%= p.item %></td>
                <td><%= p.price %></td>
                <td><%= p.location %></td>
                <td>
                    <small class="text-muted">
                        <%= p.created_at ? new Date(p.created_at).toLocaleDateString('ar-EG') : 'غير متوفر' %>
                    </small>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>

    <!-- إخلاء المسؤولية -->
    <footer class="mt-5 p-3 text-center border-top">
        <p class="text-muted small">هذه منصة تطوعية. الأسعار استرشادية وتعتمد على مساهمات المستخدمين.</p>
    </footer>

    <!-- كود البحث -->
    <script>
        document.getElementById('searchInput').addEventListener('keyup', function() {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#priceTable tbody tr');
            rows.forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
</body>
</html>
